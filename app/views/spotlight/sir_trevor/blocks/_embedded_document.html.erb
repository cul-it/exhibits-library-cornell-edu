<div class="box" data-id="<%= document.id %>">
  <% view_config = blacklight_config.view_config(:embed) %>
  <%# BEGIN CUSTOMIZATION - pass in initial_page from block_options to custom document_component (SolrDocumentLegacyEmbedComponent) %>
  <%
    block_options = block_options || {}
    initial_page = initial_page(document, block_options)
  %>
  <%= render (view_config.document_component || Spotlight::SolrDocumentLegacyEmbedComponent)
              .new(document: document_presenter(document, view_config: view_config),
                   counter: nil, block: local_assigns[:block], initial_page: initial_page) %>
  <%# END CUSTOMIZATION %>
</div>
